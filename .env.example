# docker-compose가 이 값들로 PostgreSQL+TimescaleDB 컨테이너와 backend/worker를 띄운다.
# 복사해서 .env로 저장하고 값을 채운다: cp .env.example .env
# .env는 git에 올라가지 않는다(.gitignore).

DB_NAME=crowd_pulse
DB_USER=crowd_pulse_user
DB_PASSWORD=change-me

# backend/worker가 테스트(미승인) ROI로도 분석을 돌릴 수 있게 허용할지
ALLOW_TEST_ANALYSIS=true
